[Unit]
Description=Update Codex in Jag Compose environment %i when unused
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=JAG_COMPOSE_FILE=/srv/jag-cli/deploy/compose.yaml
Environment=JAG_ENV_FILE=/srv/jag-cli/deploy/.env
Environment=JAG_COMPOSE_EXTRA=
EnvironmentFile=-/etc/jag/%i.env
ExecStart=/usr/local/bin/jag host update --project %i --compose ${JAG_COMPOSE_FILE} --env-file ${JAG_ENV_FILE} --compose-extra ${JAG_COMPOSE_EXTRA}
TimeoutStartSec=55min
UMask=0077
