Port 22
HostKey /var/lib/jara/ssh/ssh_host_ed25519_key
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM no
AuthorizedKeysFile /etc/ssh/authorized_keys/%u
AllowTcpForwarding yes
AllowStreamLocalForwarding yes
# Devices running an agent locally publish their session through a reverse
# Unix-socket forward; replace a socket left by a dropped connection and
# notice dead connections so a device can reconnect.
StreamLocalBindUnlink yes
ClientAliveInterval 30
ClientAliveCountMax 3
X11Forwarding no
AllowAgentForwarding no
PermitUserEnvironment no
Subsystem sftp internal-sftp
PrintMotd no
Include /run/jara/sshd-env.conf
